{
  "name": "@sentora/vaults-cli",
  "version": "1.0.0",
  "description": "Read-only agent-facing CLI over the Sentora vault packages: vault state, unsigned tx plans, yields API",
  "license": "MIT",
  "author": "Sentora",
  "homepage": "https://vaults.sentora.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentora-defi/smart-yield-sdk.git",
    "directory": "packages/vaults-cli"
  },
  "bugs": {
    "url": "https://github.com/sentora-defi/smart-yield-sdk/issues"
  },
  "keywords": [
    "defi",
    "vaults",
    "cli",
    "agents"
  ],
  "engines": {
