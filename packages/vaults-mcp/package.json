    "@sentora/vaults-upshift-financial": "*",
    "@sentora/yields-client": "*",
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "viem": "2.55.15",
    "zod": "^4.6.7"
  }
