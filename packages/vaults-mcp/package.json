{
  "name": "@sentora/vaults-mcp",
  "version": "1.0.0",
  "description": "MCP stdio server exposing the smart-yield command surface as read-only tools: vault discovery, yield analytics, positions, unsigned tx plans",
  "license": "MIT",
  "author": "Sentora",
  "homepage": "https://vaults.sentora.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sentora-defi/smart-yield-sdk.git",
    "directory": "packages/vaults-mcp"
  },
  "bugs": {
    "url": "https://github.com/sentora-defi/smart-yield-sdk/issues"
  },
  "keywords": [
    "defi",
    "vaults",
    "mcp",
    "agents"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "type": "module",
  "bin": {
    "smart-yield-mcp": "dist/mcp.mjs"
